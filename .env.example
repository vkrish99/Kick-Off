# --- Groq (free LLM inference — get key at console.groq.com) ---
GROQ_API_KEY=your_groq_api_key

# --- Pinecone (vector database — get key at app.pinecone.io) ---
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=pitchmaster-index

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=*

# --- API key for write endpoints (/ingest/*), sent as the X-API-Key header ---
# Leave empty only for local development. On a public server set a long random
# value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# The seed scripts read it from here too.
API_KEY=

# --- Logging (set to true for JSON logs in production) ---
LOG_JSON=false

# --- InfluxDB (optional — telemetry time-series persistence) ---
# Start with: docker-compose up -d influxdb
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=pitchmaster-token
INFLUXDB_ORG=pitchmaster
INFLUXDB_BUCKET=telemetry

# --- API-Football (optional — real player injury/availability sync) ---
# Free key (100 requests/day): https://dashboard.api-football.com
# Then run: python scripts/sync_player_status.py
API_FOOTBALL_KEY=
# Comma-separated league ids: 39=Premier League, 140=La Liga, 135=Serie A, 78=Bundesliga, 61=Ligue 1
API_FOOTBALL_LEAGUES=39
# Season start year (2025 = 2025/26). Free plans may only cover older seasons —
# the sync prints API-Football's error message if yours isn't allowed.
API_FOOTBALL_SEASON=2025
