# --- Groq (free LLM inference — get key at console.groq.com) ---
GROQ_API_KEY=your_groq_api_key

# --- Pinecone (vector database — get key at app.pinecone.io) ---
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=pitchmaster-index

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=*

# --- Logging (set to true for JSON logs in production) ---
LOG_JSON=false

# --- InfluxDB (optional — telemetry time-series persistence) ---
# Start with: docker-compose up -d influxdb
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=pitchmaster-token
INFLUXDB_ORG=pitchmaster
INFLUXDB_BUCKET=telemetry
